# 이 파일을 .env로 복사하고, 필요한 줄만 주석(#)을 풀어서 값을 채운다.
# .env는 커밋하지 않는다 (.gitignore 등록됨)
# 주의: "KEY=" 처럼 값을 비운 채로 주석을 풀면 기본값 대신 빈 값이 들어간다

# LLM: mock(기본값, API 호출 없음) / openai(실제 호출, 키와 모델 필요)
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-6-astra

# DB (기본값: jdbc:postgresql://localhost:5432/swmvp, postgres/postgres)
# DB_URL=jdbc:postgresql://localhost:5432/swmvp
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
